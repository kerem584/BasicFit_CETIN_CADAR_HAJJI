<UserControl x:Class="BasicFit_CETIN_CADAR_HAJJI.Responsable.UC_Categories"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BasicFit_CETIN_CADAR_HAJJI.Responsable"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="Catégorie des cours"
                       FontSize="20" FontWeight="Bold"
                       Margin="0,0,0,16"
                   Foreground="#F97316"/>

                <TextBox x:Name="Catégories"
                     Width="250"
                     Margin="0,0,0,12"
                     HorizontalAlignment="Left"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <DataGrid x:Name="dgCategories"
                      Grid.Column="0"
                      MaxHeight="250"
                      IsReadOnly="True"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      SelectionMode="Single"
                      ItemsSource="{Binding LesCategories}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nom"         Binding="{Binding CategorieNom}"         Width="*"/>
                        <DataGridTextColumn Header="Description" Binding="{Binding CategorieDescription}" Width="2*"/>
                    </DataGrid.Columns>

                </DataGrid>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Top">
                    <Button x:Name="btnAjouter"
                        Content="Ajouter"
                        Width="120" Height="30"
                        Margin="0,0,0,8"
                        Click="btnAjouter_Click"
                        Background="#F97316"
                        Foreground="White"
                        BorderThickness="0"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2">
                <GroupBox Header="Nouvelle catégorie" BorderBrush="#F97316" BorderThickness="1">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Nom *" Grid.Row="0" Grid.Column="0"
                               VerticalAlignment="Center" Margin="0,0,8,8"/>
                        <TextBox x:Name="tbNom" Grid.Row="0" Grid.Column="1"
                             Margin="0,0,16,8"/>

                        <TextBlock Text="Description *" Grid.Row="1" Grid.Column="0"
                               VerticalAlignment="Top" Margin="0,4,8,0"/>
                        <TextBox x:Name="tbDescription" Grid.Row="1" Grid.Column="1"
                             Grid.ColumnSpan="3"
                             Height="60"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </GroupBox>

                <Button x:Name="btnValiderAjout"
                    Content="Valider l'ajout"
                    Width="120" Height="30"
                    HorizontalAlignment="Right"
                    Margin="0,8,0,0"
                    Click="btnValiderAjout_Click"
                    Background="#F97316"
                    Foreground="White"
                    BorderThickness="0"/>
            </StackPanel>

        </Grid>
    </ScrollViewer>
</UserControl>