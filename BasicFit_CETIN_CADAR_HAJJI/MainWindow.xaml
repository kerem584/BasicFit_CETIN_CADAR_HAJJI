<Window x:Class="BasicFit_CETIN_CADAR_HAJJI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Basic Fit" Height="600" Width="1025"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Background="#1A1F2E">

            <StackPanel DockPanel.Dock="Top" Margin="16,20,16,16">
                <Image Source="/Img/logo.png" Height="40"/>
                <TextBlock Text="Réservations de cours"
                           FontSize="10" Foreground="#94A3B8"
                           Margin="0,4,0,0"/>
                <Separator Background="#334155" Margin="0,12,0,0"/>
                <TextBlock x:Name="tbNomUser"
                           Text="Utilisateur"
                           FontSize="12" FontWeight="Bold"
                           Foreground="White"
                           Margin="0,10,0,2"/>
                <TextBlock x:Name="tbRoleUser"
                           Text=""
                           FontSize="12" Foreground="#F97316" FontWeight="Bold"/>
                <Separator Background="#F97316" Margin="0,12,0,0"/>
            </StackPanel>

            <Button DockPanel.Dock="Bottom"
                    Content="Se déconnecter"
                    Margin="12,12"
                    Padding="0,10"
                    Cursor="Hand"
                    Background="#EF4444"
                    Foreground="White"
                    FontSize="11" FontWeight="Bold"
                    BorderThickness="0"
                    Click="btnDeconnexion_Click"/>

            <StackPanel x:Name="spMenu"
                        DockPanel.Dock="Top"
                        Margin="0,4,0,0"/>

        </DockPanel>

        <ContentControl x:Name="ZoneContenu"
                        Grid.Column="1"
                        Background="#F8F9FA"/>

    </Grid>
</Window>