<UserControl x:Class="BasicFit_CETIN_CADAR_HAJJI.Employe.UC_AccueilEmploye"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" Width="806">

    <StackPanel Margin="20">

        <TextBlock Text="Accueil"
                   FontSize="20" FontWeight="Bold"
                   Margin="0,0,0,4"
                   Foreground="#F97316"/>
        <TextBlock x:Name="tbDate"
                   FontSize="13" Foreground="Gray"
                   Margin="0,0,0,20"/>

        <!-- FILTRE JOUR -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Jour : "
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <ComboBox x:Name="cbJour"
                      Width="150"
                      SelectionChanged="cbJour_SelectionChanged"/>
        </StackPanel>

        <!-- DATAGRID -->
        <DataGrid x:Name="dgSeances"
                  Height="350"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Heure début"
                                    Binding="{Binding HeureDebut, StringFormat=hh\\:mm}"
                                    Width="*"/>
                <DataGridTextColumn Header="Heure fin"
                                    Binding="{Binding HeureFin, StringFormat=hh\\:mm}"
                                    Width="*"/>
                <DataGridTextColumn Header="Cours"
                                    Binding="{Binding Cours.CoursNom}"
                                    Width="2*"/>
                <DataGridTextColumn Header="Salle"
                                    Binding="{Binding Salle.SalleNom}"
                                    Width="*"/>
                <DataGridTextColumn Header="Entraîneur"
                                    Binding="{Binding Entraineur.EntraineurPrenom}"
                                    Width="*"/>
                <DataGridTextColumn Header="Places"
                                    Binding="{Binding NbPlaces}"
                                    Width="*"/>
                <DataGridTemplateColumn Header="" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Détails"
                                    Width="70" Height="24"
                                    Click="btnDetails_Click"                                   
                                    Background="#F97316"
                                    Foreground="White"
                                    BorderThickness="0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

    </StackPanel>
</UserControl>