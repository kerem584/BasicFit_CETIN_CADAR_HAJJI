<UserControl x:Class="BasicFit_CETIN_CADAR_HAJJI.Employe.UC_InscrireClient"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TITRE -->
        <TextBlock Grid.Row="0"
                   Text="Inscrire un client"
                   FontSize="20" FontWeight="Bold"
                   Margin="0,0,0,16"
                   Foreground="#F97316"/>

        <!-- RECHERCHE CLIENT -->
        <GroupBox Grid.Row="1" Header="Rechercher un client" Margin="0,0,0,12" BorderBrush="#F97316" BorderThickness="1">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="tbRecherche"
                         Grid.Column="0"
                         Margin="0,0,8,0"
                         TextChanged="tbRecherche_TextChanged"/>
                <Button x:Name="btnNouveauClient"
                        Grid.Column="2"
                        Content="+ Nouveau client"
                        Height="28" Padding="12,0"
                        Click="btnNouveauClient_Click"
                        Background="#F97316"
                        Foreground="White"
                        BorderThickness="0"/>
            </Grid>
        </GroupBox>

        <!-- DATAGRID CLIENTS + SÉANCES -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LISTE CLIENTS -->
            <GroupBox Grid.Column="0" Header="Clients trouvés" BorderBrush="#F97316" BorderThickness="1">
                <DataGrid x:Name="dgClients"
                          IsReadOnly="True"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          SelectionMode="Single"
                          SelectionChanged="dgClients_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nom"    Binding="{Binding Nom}"    Width="*"/>
                        <DataGridTextColumn Header="Prénom" Binding="{Binding Prenom}" Width="*"/>
                        <DataGridTextColumn Header="Mail"   Binding="{Binding Mail}"   Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <!-- LISTE SÉANCES -->
            <GroupBox Grid.Column="2" Header="Choisir une séance" BorderBrush="#F97316" BorderThickness="1">
                <DataGrid x:Name="dgSeances"
                          IsReadOnly="True"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Jour"   Binding="{Binding JourNom}"          Width="*"/>
                        <DataGridTextColumn Header="Heure"  Binding="{Binding HeureDebut, StringFormat=hh\\:mm}" Width="*"/>
                        <DataGridTextColumn Header="Cours"  Binding="{Binding Cours.CoursNom}"   Width="2*"/>
                        <DataGridTextColumn Header="Places" Binding="{Binding NbPlaces}"          Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>

        <!-- RÉSUMÉ SÉLECTION -->
        <GroupBox Grid.Row="3" Header="Récapitulatif" Margin="0,12,0,12" BorderBrush="#F97316" BorderThickness="1">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Client : " Grid.Column="0"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="tbClientSelectionne"
                           Grid.Column="1"
                           Foreground="Gray"
                           Text="Aucun client sélectionné"
                           VerticalAlignment="Center"/>

                <TextBlock Text="Séance : " Grid.Column="2"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
                <TextBlock x:Name="tbSeanceSelectionnee"
                           Grid.Column="3"
                           Foreground="Gray"
                           Text="Aucune séance sélectionnée"
                           VerticalAlignment="Center"/>
            </Grid>
        </GroupBox>

        <!-- BOUTON VALIDER -->
        <Button Grid.Row="4"
                x:Name="btnValider"
                Content="Valider l'inscription"
                Height="34"
                HorizontalAlignment="Right"
                Padding="20,0"
                Click="btnValider_Click"
                Background="#F97316"
                Foreground="White"
                BorderThickness="0"/>

    </Grid>
</UserControl>