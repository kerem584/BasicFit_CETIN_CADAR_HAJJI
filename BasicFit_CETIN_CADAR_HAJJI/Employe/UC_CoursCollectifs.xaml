<UserControl x:Class="BasicFit_CETIN_CADAR_HAJJI.Employe.UC_CoursCollectifs"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <StackPanel Margin="20">

        <TextBlock Text="Cours collectifs"
                   FontSize="20" FontWeight="Bold"
                   Margin="0,0,0,16"
                   Foreground="#F97316"/>

        <GroupBox Header="Filtres" Margin="0,0,0,12" BorderBrush="#F97316" BorderThickness="1">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Catégorie :" Grid.Column="0"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="cbFiltreCategorie" Grid.Column="1"
                          DisplayMemberPath="CategorieNom"
                          Margin="0,0,16,0"
                          SelectionChanged="Filtre_Changed"/>

                <TextBlock Text="Jour :" Grid.Column="2"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="cbFiltreJour" Grid.Column="3"
                          Margin="0,0,16,0"
                          SelectionChanged="Filtre_Changed"/>

                <TextBlock Text="Places dispo :" Grid.Column="4"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <CheckBox x:Name="cbPlacesDispo" Grid.Column="5"
                          VerticalAlignment="Center"
                          Checked="Filtre_Changed"
                          Unchecked="Filtre_Changed"/>
            </Grid>
        </GroupBox>

        <DataGrid x:Name="dgSeances"
                  Height="280"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  SelectionChanged="dgSeances_SelectionChanged"
                  AlternatingRowBackground="#FFF3E8">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#F97316"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding"    Value="8,6"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Cours"       Binding="{Binding Cours.CoursNom, ValidatesOnExceptions=True}"           Width="*"/>
                <DataGridTextColumn Header="Catégorie"   Binding="{Binding Cours.Categorie.CategorieNom, ValidatesOnExceptions=True}" Width="*"/>
                <DataGridTextColumn Header="Jour"        Binding="{Binding JourNom, ValidatesOnExceptions=True}"                  Width="*"/>
                <DataGridTextColumn Header="Début"       Binding="{Binding HeureDebut, StringFormat=hh\\:mm, ValidatesOnExceptions=True}" Width="*"/>
                <DataGridTextColumn Header="Fin"         Binding="{Binding HeureFin, StringFormat=hh\\:mm, ValidatesOnExceptions=True}"   Width="*"/>
                <DataGridTextColumn Header="Salle"       Binding="{Binding Salle.SalleNom, ValidatesOnExceptions=True}"           Width="*"/>
                <DataGridTextColumn Header="Entraîneur"  Binding="{Binding Entraineur.EntraineurPrenom, ValidatesOnExceptions=True}" Width="*"/>
                <DataGridTextColumn Header="Places"      Binding="{Binding NbPlaces, ValidatesOnExceptions=True}"                 Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <GroupBox x:Name="gbDetail" Header="Détail de la séance" Margin="0,12,0,0"
                  Visibility="Collapsed">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Cours :" Grid.Row="0" Grid.Column="0" Margin="0,0,8,4"/>
                <TextBox x:Name="tbDetailCours" Grid.Row="0" Grid.Column="1"
                         IsReadOnly="True" Margin="0,0,16,4"/>

                <TextBlock Text="Entraîneur :" Grid.Row="0" Grid.Column="2" Margin="0,0,8,4"/>
                <TextBox x:Name="tbDetailEntraineur" Grid.Row="0" Grid.Column="3"
                         IsReadOnly="True" Margin="0,0,0,4"/>

                <TextBlock Text="Salle :" Grid.Row="1" Grid.Column="0" Margin="0,0,8,0"/>
                <TextBox x:Name="tbDetailSalle" Grid.Row="1" Grid.Column="1"
                         IsReadOnly="True" Margin="0,0,16,0"/>

                <TextBlock Text="Places restantes :" Grid.Row="1" Grid.Column="2" Margin="0,0,8,0"/>
                <TextBox x:Name="tbDetailPlaces" Grid.Row="1" Grid.Column="3"
                         IsReadOnly="True" Margin="0,0,0,0"/>
            </Grid>
        </GroupBox>

    </StackPanel>
</UserControl>