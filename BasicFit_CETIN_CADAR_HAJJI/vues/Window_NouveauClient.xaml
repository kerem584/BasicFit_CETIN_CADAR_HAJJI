<Window x:Class="BasicFit_CETIN_CADAR_HAJJI.vues.Window_NouveauClient"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nouveau client"
        Height="420" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Nom *"            Grid.Row="0" Grid.Column="0" Margin="0,8"/>
        <TextBox   x:Name="tbNom"          Grid.Row="0" Grid.Column="1" Margin="0,8"/>

        <TextBlock Text="Prénom *"         Grid.Row="1" Grid.Column="0" Margin="0,8"/>
        <TextBox   x:Name="tbPrenom"       Grid.Row="1" Grid.Column="1" Margin="0,8"/>

        <TextBlock Text="Mail *"           Grid.Row="2" Grid.Column="0" Margin="0,8"/>
        <TextBox   x:Name="tbMail"         Grid.Row="2" Grid.Column="1" Margin="0,8"/>

        <TextBlock Text="Téléphone *"      Grid.Row="3" Grid.Column="0" Margin="0,8"/>
        <TextBox   x:Name="tbTelephone"    Grid.Row="3" Grid.Column="1" Margin="0,8"/>

        <TextBlock Text="Date naissance *" Grid.Row="4" Grid.Column="0" Margin="0,8"/>
        <DatePicker x:Name="dpDateNaissance" Grid.Row="4" Grid.Column="1" Margin="0,8"/>

        <TextBlock Text="Adresse"          Grid.Row="5" Grid.Column="0" Margin="0,8"/>
        <TextBox   x:Name="tbAdresse"      Grid.Row="5" Grid.Column="1" Margin="0,8"/>

        <TextBlock Text="Code postal"      Grid.Row="6" Grid.Column="0" Margin="0,8"/>
        <TextBox   x:Name="tbCodePostal"   Grid.Row="6" Grid.Column="1" Margin="0,8"/>

        <TextBlock Text="Ville"            Grid.Row="7" Grid.Column="0" Margin="0,8"/>
        <TextBox   x:Name="tbVille"        Grid.Row="7" Grid.Column="1" Margin="0,8"/>

        <StackPanel Grid.Row="8" Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom">
            <Button Content="Annuler" Width="90" Height="30"
                    Margin="0,0,8,0" IsCancel="True"
                    Click="btnAnnuler_Click"/>
            <Button Content="Valider" Width="90" Height="30"
                    Click="btnValider_Click"/>
        </StackPanel>
    </Grid>
</Window>