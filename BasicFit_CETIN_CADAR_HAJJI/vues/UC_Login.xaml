<UserControl x:Class="BasicFit_CETIN_CADAR_HAJJI.vues.UC_Login"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BasicFit_CETIN_CADAR_HAJJI.vues"
             mc:Ignorable="d" 
             Background="#1A1F2E">
    <Grid>

        <Border Background="White"
                CornerRadius="16"
                Padding="40,36"
                Width="380"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">

            <Border.Effect>
                <DropShadowEffect BlurRadius="24" Opacity="0.18" ShadowDepth="4"/>
            </Border.Effect>

            <StackPanel>
                <Image Source="/img/logo.png" Width="200" Height="70" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                <TextBlock Text="Suivi des réservations de cours"
                           FontSize="12"
                           Foreground="#94A3B8"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,28"/>

                <TextBlock Text="Identifiant"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="#374151"
                           Margin="0,0,0,4"/>
                <Border BorderBrush="#E2E8F0" BorderThickness="1"
                        CornerRadius="6" Margin="0,0,0,16">
                    <TextBox x:Name="tbLogin"
                        BorderThickness="0"
                        Padding="10,8"
                        FontSize="12"
                        Background="Transparent"/>
                </Border>

                <!-- Mot de passe -->
                <TextBlock Text="Mot de passe"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="#374151"
                           Margin="0,0,0,4"/>
                <Border BorderBrush="#E2E8F0" BorderThickness="1"
                        CornerRadius="6" Margin="0,0,0,28">
                    <PasswordBox x:Name="pbMdp"
                                 BorderThickness="0"
                                 Padding="10,8"
                                 FontSize="12"
                                 Background="Transparent"/>
                </Border>

                <!-- Message d'erreur (caché par défaut) -->
                <TextBlock x:Name="tbErreur"
                           Text="Identifiant ou mot de passe incorrect"
                           Foreground="#EF4444"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"
                           Visibility="Collapsed"/>

                <!-- Bouton Connexion -->
                <Button x:Name="btnConnexion"
                        Content="Se connecter"
                        Foreground="White"
                        FontSize="13" FontWeight="Bold"
                        Background="#F97316"
                        BorderThickness="0"
                        Padding="0,12"
                        Cursor="Hand"
                        Click="btnConnexion_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>