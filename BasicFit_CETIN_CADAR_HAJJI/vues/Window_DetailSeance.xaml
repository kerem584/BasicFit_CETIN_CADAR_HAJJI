<Window x:Class="BasicFit_CETIN_CADAR_HAJJI.Vues.Window_DetailSeance"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Détail de la séance"
        Height="450" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <StackPanel Margin="20">

        <TextBlock x:Name="tbTitre"
                   FontSize="18" FontWeight="Bold"
                   Margin="0,0,0,4"
                   Foreground="#F97316"/>
        <TextBlock x:Name="tbSousTitre"
                   FontSize="12" Foreground="Gray"
                   Margin="0,0,0,20"/>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Entraîneur : " Grid.Row="0" Grid.Column="0" Margin="0,4"/>
            <TextBlock x:Name="tbEntraineur" Grid.Row="0" Grid.Column="1" Margin="0,4"/>

            <TextBlock Text="Salle : " Grid.Row="1" Grid.Column="0" Margin="0,4"/>
            <TextBlock x:Name="tbSalle" Grid.Row="1" Grid.Column="1" Margin="0,4"/>

            <TextBlock Text="Inscrits : " Grid.Row="2" Grid.Column="0" Margin="0,4"/>
            <TextBlock x:Name="tbInscrits" Grid.Row="2" Grid.Column="1" Margin="0,4"/>
        </Grid>

        <Separator Margin="0,0,0,12"/>

        <TextBlock Text="Liste des inscrits"
                   FontWeight="Bold"
                   Margin="0,0,0,8"/>

        <DataGrid x:Name="dgInscrits"
                  Height="200"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nom"     Binding="{Binding Client.Nom}"       Width="*"/>
                <DataGridTextColumn Header="Prénom"  Binding="{Binding Client.Prenom}"    Width="*"/>
                <DataGridTextColumn Header="Téléphone" Binding="{Binding Client.Telephone}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

    </StackPanel>
</Window>